# nginx fills in ${BUY_URL} and ${KEY_API} from the Cloud Run environment at start.
server {
    listen 8080;
    root /usr/share/nginx/html;
    index index.html;
    # Relative redirects, or nginx sends browsers to its own port 8080.
    absolute_redirect off;

    # The Stripe Checkout link. One place to change it, and the buttons keep a clean /buy.
    location = /buy { return 302 ${BUY_URL}; }
    # The newest notarized build.
    location = /download { return 302 /SwitchForClaude.dmg; }
    location ~ ^/SwitchForClaude[-.0-9]*\.dmg$ {
        types { application/x-apple-diskimage dmg; }
        add_header Content-Disposition 'attachment';
    }
    # Sparkle reads this once a day from every installed copy.
    location = /appcast.xml { add_header Cache-Control 'no-cache'; }
    # Pages are always checked with the server, so a change is seen at the next visit.
    location / { try_files $uri $uri/ =404; add_header Cache-Control 'no-cache'; }
    location ~ \.html$ { add_header Cache-Control 'no-cache'; }
    # Sending a lost key again goes to the license service.
    location = /api/resend-key { proxy_pass ${KEY_API}/resend-key; proxy_ssl_server_name on; }
}
